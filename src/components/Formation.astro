---
import { formation } from '../data/content';

// SVG paths per degree index (0=masters, 1=law)
const icons = [
  // Graduation cap
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C4973C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
  // Scales of justice
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C4973C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>`,
];
---

<section id="formation" class="bg-off-white py-24">
  <div class="max-w-container mx-auto px-6">

    <div class="text-center mb-16" data-reveal>
      <span class="section-label">Credenciales académicas</span>
      <h2 class="font-serif font-bold text-navy"
          style="font-size: clamp(26px,3.5vw,44px);">
        Formación de Élite
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" data-reveal data-reveal-delay="80">

      {formation.degrees.map((d, i) => (
        <div class="group relative bg-white border border-light-gray rounded-xl p-8 transition-all duration-300 hover:border-gold/35 hover:-translate-y-1 hover:shadow-[0_12px_36px_rgba(13,27,42,.07)] overflow-hidden">
          <span class="absolute bottom-0 left-0 right-0 h-[2px] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300"
                style="background:linear-gradient(90deg,#C4973C,#DEB96A);"></span>
          <div class="w-11 h-11 rounded-lg flex items-center justify-center mb-6"
               style="background:linear-gradient(135deg,#0D1B2A,#1E3252);">
            <Fragment set:html={icons[i]} />
          </div>
          <p class="text-[10px] font-semibold tracking-[2.5px] uppercase text-gold mb-2">{d.year}</p>
          <h3 class="font-serif text-[17px] font-bold text-navy leading-snug mb-1.5">{d.degree}</h3>
          <p class="text-xs text-oxford-light font-medium">{d.institution}</p>
        </div>
      ))}

      <!-- Certifications panel -->
      <div class="col-span-full rounded-xl p-10 border border-gold/12"
           style="background:#070F18;" data-reveal data-reveal-delay="160">
        <span class="section-label">Certificaciones Especializadas</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-1">
          {formation.certs.map(c => (
            <div class="flex items-start gap-3 px-4 py-3.5 rounded-lg border border-gold/8"
                 style="background:rgba(255,255,255,.025);">
              <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0 mt-[5px]"></span>
              <span class="text-[11px] text-white/72 font-medium leading-snug">{c}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
