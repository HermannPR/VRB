---
import { hero } from '../data/content';
---

<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden pt-20"
  style="background: #070F18;"
>
  <!-- bg diagonal panel -->
  <div
    class="absolute top-0 right-0 w-[52%] h-full opacity-60"
    style="background: linear-gradient(135deg,#1E3252 0%,#070F18 70%); clip-path: polygon(18% 0,100% 0,100% 100%,0% 100%);"
  ></div>
  <!-- grid overlay -->
  <div
    class="absolute top-0 right-0 w-[52%] h-full"
    style="background-image: linear-gradient(rgba(196,151,60,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(196,151,60,.04) 1px,transparent 1px); background-size:56px 56px; clip-path: polygon(18% 0,100% 0,100% 100%,0% 100%);"
  ></div>
  <!-- left accent line -->
  <div
    class="absolute left-0 top-1/4 w-[3px] h-52"
    style="background: linear-gradient(to bottom,transparent,#C4973C,transparent);"
  ></div>

  <div class="max-w-container mx-auto px-6 relative z-10">
    <div class="max-w-[700px]">

      <!-- badge -->
      <div class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 mb-7"
           style="background:rgba(196,151,60,.1); border:1px solid rgba(196,151,60,.3);">
        <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse-dot"></span>
        <span class="text-[11px] font-semibold tracking-[2px] uppercase text-gold-light">{hero.badge}</span>
      </div>

      <!-- name -->
      <p class="font-serif text-[15px] font-normal text-oxford-light tracking-[4px] uppercase mb-5">
        {hero.name}
      </p>

      <!-- headline -->
      <h1 class="font-serif font-bold text-white leading-[1.13] mb-6"
          style="font-size: clamp(30px, 4.2vw, 54px);">
        {hero.headline[0]}<em class="text-gold not-italic">{hero.headline[1]}</em>{hero.headline[2]}
      </h1>

      <!-- subtext -->
      <p class="text-base leading-relaxed text-white/60 max-w-[560px] mb-11">
        {hero.subtext}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3 items-center">
        <a href={hero.ctas.primary.href}
           target="_blank" rel="noopener"
           class="inline-flex items-center gap-2.5 bg-gold text-navy-dark px-8 py-3.5 rounded text-sm font-bold border-2 border-gold transition-all duration-200 hover:bg-gold-light hover:border-gold-light hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(196,151,60,.35)]">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          {hero.ctas.primary.label}
        </a>
        <a href={hero.ctas.secondary.href}
           target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 bg-transparent text-white px-7 py-3.5 rounded text-sm font-medium border-2 transition-all duration-200 hover:bg-white/5"
           style="border-color:rgba(255,255,255,.22);">
          {hero.ctas.secondary.label}
        </a>
      </div>

      <!-- award card -->
      <div class="inline-flex items-center gap-4 mt-12 px-6 py-4 rounded-xl"
           style="background:rgba(196,151,60,.07); border:1px solid rgba(196,151,60,.22);">
        <div class="w-11 h-11 rounded-full bg-gold flex items-center justify-center text-xl shrink-0">🏆</div>
        <div>
          <div class="text-[9px] font-bold tracking-[2.5px] uppercase text-gold">{hero.award.source}</div>
          <div class="font-serif text-[14px] font-semibold text-white mt-0.5 leading-snug">{hero.award.title}</div>
        </div>
      </div>

    </div>
  </div>
</section>
