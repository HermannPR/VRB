---
import { hero } from '../data/content';
---

<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden pt-20"
  style="background: #070F18;"
>
  <!-- diagonal bg panel -->
  <div
    class="absolute top-0 right-0 w-[52%] h-full"
    style="background: linear-gradient(135deg,#1E3252 0%,#070F18 75%); clip-path: polygon(18% 0,100% 0,100% 100%,0% 100%); opacity:.55;"
  ></div>
  <!-- fine grid -->
  <div
    class="absolute top-0 right-0 w-[52%] h-full pointer-events-none"
    style="background-image:linear-gradient(rgba(196,151,60,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(196,151,60,.035) 1px,transparent 1px); background-size:60px 60px; clip-path:polygon(18% 0,100% 0,100% 100%,0% 100%);"
  ></div>
  <!-- left vertical accent -->
  <div
    class="absolute left-0 top-[22%] w-px h-64 pointer-events-none"
    style="background: linear-gradient(to bottom,transparent,rgba(196,151,60,.5),transparent);"
  ></div>

  <div class="max-w-container mx-auto px-6 relative z-10 py-16">
    <div class="max-w-[680px]">

      <!-- status badge -->
      <div class="inline-flex items-center gap-2.5 rounded-full px-4 py-1.5 mb-8"
           style="background:rgba(196,151,60,.08); border:1px solid rgba(196,151,60,.25);">
        <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse-dot shrink-0"></span>
        <span class="text-[10px] font-semibold tracking-[2.5px] uppercase text-gold-light">{hero.badge}</span>
      </div>

      <!-- name -->
      <p class="text-[13px] font-normal text-oxford-light tracking-[4px] uppercase mb-6 font-sans">
        {hero.name}
      </p>

      <!-- headline -->
      <h1 class="font-serif font-bold text-white mb-7"
          style="font-size: clamp(28px, 4vw, 52px); line-height: 1.12;">
        {hero.headline[0]}<em class="text-gold not-italic">{hero.headline[1]}</em>{hero.headline[2]}
      </h1>

      <!-- subtext -->
      <p class="text-[15px] leading-[1.75] text-white/55 max-w-[560px] mb-12">
        {hero.subtext}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3 items-center mb-12">
        <a href={hero.ctas.primary.href}
           target="_blank" rel="noopener"
           class="inline-flex items-center gap-2.5 bg-gold text-navy-dark px-8 py-3.5 rounded-[3px] text-sm font-bold border-2 border-gold transition-all duration-200 hover:bg-gold-light hover:border-gold-light hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(196,151,60,.3)]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          {hero.ctas.primary.label}
        </a>
        <a href={hero.ctas.secondary.href}
           target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 text-white/70 px-6 py-3.5 rounded-[3px] text-sm font-medium border transition-all duration-200 hover:text-white hover:border-white/40 hover:bg-white/4"
           style="border-color:rgba(255,255,255,.18);">
          {hero.ctas.secondary.label}
        </a>
      </div>

      <!-- award card -->
      <div class="inline-flex items-center gap-4 px-6 py-4 rounded-lg"
           style="background:rgba(196,151,60,.06); border:1px solid rgba(196,151,60,.18);">
        <!-- medal/award SVG -->
        <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0"
             style="background:rgba(196,151,60,.15); border:1px solid rgba(196,151,60,.3);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C4973C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="6"/>
            <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
          </svg>
        </div>
        <div>
          <div class="text-[9px] font-bold tracking-[2.5px] uppercase text-gold mb-0.5">{hero.award.source}</div>
          <div class="font-serif text-[14px] font-semibold text-white leading-snug">{hero.award.title}</div>
        </div>
      </div>

    </div>
  </div>
</section>
