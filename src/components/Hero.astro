---
import { hero } from '../data/content';
---

<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden pt-20"
  style="background: #070F18;"
>
  <!-- diagonal bg panel -->
  <div
    class="absolute top-0 right-0 w-[52%] h-full"
    style="background: linear-gradient(135deg,#1E3252 0%,#070F18 75%); clip-path: polygon(18% 0,100% 0,100% 100%,0% 100%); opacity:.55;"
  ></div>
  <!-- fine grid -->
  <div
    class="absolute top-0 right-0 w-[52%] h-full pointer-events-none"
    style="background-image:linear-gradient(rgba(196,151,60,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(196,151,60,.035) 1px,transparent 1px); background-size:60px 60px; clip-path:polygon(18% 0,100% 0,100% 100%,0% 100%);"
  ></div>
  <!-- left vertical accent -->
  <div
    class="absolute left-0 top-[22%] w-px h-64 pointer-events-none"
    style="background: linear-gradient(to bottom,transparent,rgba(196,151,60,.5),transparent);"
  ></div>

  <div class="max-w-container mx-auto px-6 relative z-10 py-16">
    <div class="max-w-[740px]">

      <!-- name — primary element -->
      <h1 class="font-serif font-bold text-white mb-5"
          style="font-size: clamp(40px,7vw,88px); line-height:1.04; letter-spacing:-0.5px;">
        {hero.name}
      </h1>

      <!-- role label -->
      <p class="text-[11px] font-semibold tracking-[3.5px] uppercase mb-10"
         style="color:#C4973C;">
        Gerente Nacional de Cumplimiento · Grupo Coppel
      </p>

      <!-- tagline — smaller -->
      <p class="text-[14px] leading-[1.8] text-white/55 max-w-[520px]">
        {hero.headline[0]}<em class="not-italic" style="color:#C4973C;">{hero.headline[1]}</em>{hero.headline[2]}
      </p>

    </div>
  </div>
</section>
