---
import { contact } from '../data/content';
---

<section id="contact" class="py-24 relative overflow-hidden" style="background:#070F18;">
  <div class="absolute -top-20 -right-20 w-[480px] h-[480px] rounded-full pointer-events-none"
       style="background:radial-gradient(circle,rgba(196,151,60,.06) 0%,transparent 70%);"></div>

  <div class="max-w-container mx-auto px-6 text-center relative z-10">
    <span class="section-label">¿Hablamos?</span>

    <h2 class="font-serif font-bold text-white mb-5"
        style="font-size: clamp(30px,4.5vw,54px); line-height:1.15;">
      Construyamos juntos<br />soluciones <em class="text-gold not-italic">sólidas</em>.
    </h2>

    <p class="text-[15px] text-white/50 max-w-[500px] mx-auto mb-12 leading-relaxed">
      Disponible para posiciones directivas, consultorías estratégicas y conferencias sobre integridad corporativa y cumplimiento global.
    </p>

    <div class="flex justify-center flex-wrap gap-3 mb-12">

      <a href={contact.whatsapp.href} target="_blank" rel="noopener" class="contact-card">
        <div class="c-ico" style="background:#25D366;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </div>
        <div class="text-left">
          <div class="c-label">WhatsApp</div>
          <div class="c-val">{contact.whatsapp.label}</div>
        </div>
      </a>

      <a href="/cv-veronica-rivera.pdf" download="CV-Veronica-Rivera-Barraza.pdf" class="contact-card">
        <div class="c-ico" style="background:rgba(196,151,60,.15);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C4973C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </div>
        <div class="text-left">
          <div class="c-label">Currículum</div>
          <div class="c-val">Descargar CV</div>
        </div>
      </a>

      <a href={contact.linkedin.href} target="_blank" rel="noopener" class="contact-card">
        <div class="c-ico" style="background:#0A66C2;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
        </div>
        <div class="text-left">
          <div class="c-label">LinkedIn</div>
          <div class="c-val">{contact.linkedin.label}</div>
        </div>
      </a>

    </div>

    <div class="w-12 h-px mx-auto mb-6" style="background:linear-gradient(90deg,transparent,#C4973C,transparent);"></div>
    <p class="text-[11px] text-oxford-light tracking-[1px] flex items-center justify-center gap-2">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      {contact.location}
    </p>
  </div>
</section>

<style>
  .contact-card {
    @apply flex items-center gap-4 px-7 py-[18px] no-underline rounded-xl border transition-all duration-300 min-w-[210px];
    background: rgba(255,255,255,.04);
    border-color: rgba(255,255,255,.08);
  }
  .contact-card:hover {
    border-color: rgba(196,151,60,.4);
    background: rgba(196,151,60,.05);
    transform: translateY(-2px);
  }
  .c-ico  { @apply w-10 h-10 rounded-lg flex items-center justify-center shrink-0; }
  .c-label { @apply text-[9px] font-semibold tracking-[2px] uppercase text-oxford-light; }
  .c-val   { @apply text-[13px] font-semibold text-white mt-0.5; }
</style>
